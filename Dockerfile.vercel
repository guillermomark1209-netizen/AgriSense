# ============================================================
# Stage 1: Laravel PHP dependencies
# ============================================================
FROM dunglas/frankenphp:php8.4 AS php-builder

RUN install-php-extensions \
    pdo_pgsql \
    mbstring \
    bcmath \
    intl \
    opcache

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY . .

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-progress


# ============================================================
# Stage 2: Build Vite frontend
# ============================================================
FROM node:22-alpine AS frontend

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci

COPY resources ./resources
COPY vite.config.* ./
COPY public ./public

RUN npm run build


# ============================================================
# Stage 3: Production Laravel container
# ============================================================
FROM dunglas/frankenphp:php8.4

RUN install-php-extensions \
    pdo_pgsql \
    mbstring \
    bcmath \
    intl \
    opcache

WORKDIR /app

COPY --from=php-builder /app ./

COPY --from=frontend /app/public/build ./public/build

ENV SERVER_NAME=:80

EXPOSE 80

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]